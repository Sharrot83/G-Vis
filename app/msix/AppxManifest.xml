<?xml version="1.0" encoding="utf-8"?>
<!-- G-vis i Microsoft Store. Identiteten kommer från Partner Center (Product identity) och måste stämma exakt.
     __VERSION__ fylls i av bygg-msix.ps1 från tauri.conf.json, till exempel 1.2.0 -> 1.2.0.0. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Sharrot.G-Vis"
    Publisher="CN=7F64E66E-0DF5-46EB-B3DC-70A9EF21D6C6"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>G-vis</DisplayName>
    <PublisherDisplayName>Sharrot</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="sv-SE" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="GVis" Executable="g-vis.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="G-vis"
        Description="G-code visualizer, lexicon and CNC simulators"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- dubbelklick på en .gvis-fil öppnar G-vis -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="gvis">
            <uap:DisplayName>G-vis</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.gvis</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
